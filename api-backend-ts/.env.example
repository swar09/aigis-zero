NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database connections (match ports from infra/docker-compose.yml)
DB_NODES_URL=postgresql://edr:yourpassword@localhost:5433/edr_nodes
DB_LOGS_URL=postgresql://edr:yourpassword@localhost:5432/edr_logs
DB_ALERTS_URL=postgresql://edr:yourpassword@localhost:5434/edr_alerts

# Kafka (match infra/docker-compose.yml)
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=aigis-api-backend
KAFKA_TOPIC_ALERTS=aigis.alerts
KAFKA_TOPIC_HEALTH=aigis.health

# Auth
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Rate limiting
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000