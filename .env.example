# ==============================================================================
# Aigis-Zero EDR — Universal Environment Configuration
# ==============================================================================
# Single source of truth for local development, docker compose, and test tooling.
# Copy to .env: cp .env.example .env
# ==============================================================================

# --- Global & Operator Authentication ---
JWT_SECRET=super_secret_jwt_key_replace_in_production_32_bytes_min
JWT_EXPIRATION_SECS=86400
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=admin

# --- PostgreSQL Database Credentials & Pools ---
POSTGRES_USER=edr
POSTGRES_PASSWORD=edrpassword
DB_POOL_MAX_SIZE=16

# Partitioned Database Connection Strings
DATABASE_URL_NODES=postgres://edr:edrpassword@localhost:5433/edr_nodes
DATABASE_URL_ALERTS=postgres://edr:edrpassword@localhost:5434/edr_alerts
DATABASE_URL_LOGS=postgres://edr:edrpassword@localhost:5435/edr_logs

# Default Database URL (for fleet-server migrations / sqlx)
DATABASE_URL=postgres://edr:edrpassword@localhost:5433/edr_nodes

# --- Fleet Server (gRPC Control Plane) ---
FLEET_GRPC_URL=http://localhost:50051

# --- API Backend (REST & WebSocket Gateway) ---
HOST=0.0.0.0
PORT=8081

# --- Kafka Message Broker & Ingestion ---
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=edr-api-backend-live
KAFKA_TOPIC_AGENTS_EVENTS=aigis.events.raw

# --- Endpoint Agent ---
EDR_AGENT_CONFIG=/etc/aigis-zero/config.toml

# --- Observability & Logging ---
RUST_LOG=info,edr_api_backend=debug,fleet_server=debug
LOG_FORMAT=human
