# ==============================================================================
# Aigis-Zero EDR — Universal Environment Configuration
# ==============================================================================
# Single source of truth for local development, docker compose, and test tooling.
# All passwords, secrets, tokens, and credentials MUST lie in this global env file.
# Copy to .env: cp .env.example .env
# ==============================================================================

# --- Operator & API Authentication Secrets ---
JWT_SECRET=super_secret_jwt_key_replace_in_production_32_bytes_min
JWT_EXPIRATION_SECS=86400
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=admin_super_secret_password_change_me

# --- Fleet Server & Agent Enrollment Secrets ---
FLEET_JWT_SECRET=super_secret_fleet_jwt_key_32_bytes_min_replace
FLEET_ENROLLMENT_SECRET=aigis_node_enrollment_pre_shared_key_change_me
AGENT_ENROLLMENT_SECRET=aigis_node_enrollment_pre_shared_key_change_me

# --- PostgreSQL Database Credentials & Pools ---
POSTGRES_USER=edr
POSTGRES_PASSWORD=edrpassword_change_in_production
DB_POOL_MAX_SIZE=20

# Partitioned Database Connection Strings
DATABASE_URL_NODES=postgres://edr:edrpassword_change_in_production@localhost:5433/edr_nodes
DATABASE_URL_ALERTS=postgres://edr:edrpassword_change_in_production@localhost:5434/edr_alerts
DATABASE_URL_LOGS=postgres://edr:edrpassword_change_in_production@localhost:5435/edr_logs

# Default Database URL (for fleet-server migrations / sqlx / rule-engine)
DATABASE_URL=postgres://edr:edrpassword_change_in_production@localhost:5434/edr_alerts

# Optional: Isolated per-database passwords if running separate database clusters
POSTGRES_NODES_PASSWORD=edrpassword_change_in_production
POSTGRES_ALERTS_PASSWORD=edrpassword_change_in_production
POSTGRES_LOGS_PASSWORD=edrpassword_change_in_production

# --- Fleet Server (gRPC Control Plane) ---
FLEET_GRPC_URL=http://localhost:50051

# --- API Backend (REST & WebSocket Gateway) ---
HOST=0.0.0.0
PORT=8080

# --- Kafka Message Broker & Ingestion ---
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=edr-api-backend-live
KAFKA_TOPIC_AGENTS_EVENTS=aigis.events.raw

# Optional: Kafka SASL/TLS Authentication Credentials
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISMS=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# --- Rule Engine (Stream-Processing Detection Microservice) ---
KAFKA_GROUP_ID=aigis-rule-engine
KAFKA_TOPICS=aigis.events.process,aigis.events.network,aigis.events.file,aigis.events.auth
RULES_DIR=./rule-engine/rules
MITRE_TAXONOMY_PATH=./rule-engine/rules/mitre/enterprise-attack-linux.json
SCANNER_WORKERS=8
CHANNEL_CAPACITY=10000
DEDUP_CAPACITY=100000
DEDUP_WINDOW_SECS=60
BATCH_MAX_SIZE=500
BATCH_FLUSH_MS=100
HEALTH_PORT=8081
DLQ_TOPIC=aigis.events.dlq
ALERTS_TOPIC=aigis.alerts

# --- Endpoint Agent ---
EDR_AGENT_CONFIG=/etc/aigis-zero/config.toml

# --- Optional TLS / mTLS Certificates ---
TLS_CERT_PATH=./infra/certs/server.crt
TLS_KEY_PATH=./infra/certs/server.key
TLS_CA_PATH=./infra/certs/ca.crt

# --- Observability & Logging ---
RUST_LOG=info,edr_api_backend=debug,fleet_server=debug,edr_rule_engine=debug
LOG_FORMAT=human
