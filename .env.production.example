# ==============================================================================
# Aigis-Zero EDR — Production Environment Configuration (.env.production)
# ==============================================================================
# Suitable for Docker Compose, Kubernetes, AWS ECS, or multi-node production setups.
# Copy to .env in production and replace all secrets with cryptographically secure strings:
#   openssl rand -hex 32
# ==============================================================================

# --- Container Image Registry & Tags ---
IMAGE_REGISTRY=ghcr.io/swar09
IMAGE_TAG=latest

# --- Network Interface Binding (127.0.0.1 for reverse-proxy, 0.0.0.0 for direct) ---
FRONTEND_BIND_IP=0.0.0.0
API_BIND_IP=0.0.0.0
FLEET_BIND_IP=0.0.0.0
RULE_ENGINE_BIND_IP=127.0.0.1
PIPELINE_BIND_IP=127.0.0.1
PG_BIND_IP=127.0.0.1
KAFKA_BIND_IP=127.0.0.1
KAFKA_UI_BIND_IP=127.0.0.1

# --- Web & API Port Mappings ---
PORT=8080
FRONTEND_PORT=3000
FLEET_PORT=50051
HEALTH_PORT=8081
PIPELINE_HEALTH_PORT=8082

# --- Service Hostnames (Service Discovery in Docker / K8s / Cloud) ---
FRONTEND_URL=http://frontend:3000
BACKEND_URL=http://api-backend:8080
FLEET_GRPC_URL=http://fleet-server:50051
KAFKA_BROKERS=kafka:29092

# --- Operator & API Authentication Secrets ---
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_HEX_OR_BASE64_JWT_SECRET_MIN_32_BYTES
JWT_EXPIRATION_SECS=86400
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# --- Fleet Server & Agent Enrollment Secrets ---
# Generate with: openssl rand -hex 32
FLEET_JWT_SECRET=REPLACE_WITH_STRONG_FLEET_JWT_SECRET
FLEET_ENROLLMENT_SECRET=REPLACE_WITH_STRONG_ENROLLMENT_PRE_SHARED_KEY
AGENT_ENROLLMENT_SECRET=REPLACE_WITH_STRONG_ENROLLMENT_PRE_SHARED_KEY

# --- PostgreSQL Database Credentials & Pools ---
POSTGRES_USER=edr
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
DB_POOL_MAX_SIZE=20

# Container Database URLs (Using internal network service discovery)
DATABASE_URL_NODES=postgres://edr:${POSTGRES_PASSWORD}@postgres-nodes:5432/edr_nodes
DATABASE_URL_ALERTS=postgres://edr:${POSTGRES_PASSWORD}@postgres-alerts:5432/edr_alerts
DATABASE_URL_LOGS=postgres://edr:${POSTGRES_PASSWORD}@postgres-logs:5432/edr_logs
DATABASE_URL=postgres://edr:${POSTGRES_PASSWORD}@postgres-alerts:5432/edr_alerts

# --- Kafka Message Broker & Ingestion ---
KAFKA_CONSUMER_GROUP=edr-api-backend-live
KAFKA_TOPIC_AGENTS_EVENTS=aigis.events.raw

# Optional: Kafka SASL/TLS Authentication Credentials for Cloud (e.g. AWS MSK, Confluent Cloud)
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISMS=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# --- Rule Engine Configuration ---
KAFKA_GROUP_ID=aigis-rule-engine
KAFKA_TOPICS=aigis.events.process,aigis.events.network,aigis.events.file,aigis.events.auth
RULES_DIR=/etc/aigis/rules
MITRE_TAXONOMY_PATH=/etc/aigis/rules/mitre/enterprise-attack-linux.json
SCANNER_WORKERS=8
CHANNEL_CAPACITY=10000
DEDUP_CAPACITY=100000
DEDUP_WINDOW_SECS=60
BATCH_MAX_SIZE=500
BATCH_FLUSH_MS=100
DLQ_TOPIC=aigis.events.dlq
ALERTS_TOPIC=aigis.alerts

# --- Endpoint Agent Runtime ---
EDR_AGENT_CONFIG=/etc/aigis-zero/config.toml

# --- Observability & Structured Logging ---
RUST_LOG=info,edr_api_backend=info,fleet_server=info,edr_rule_engine=info
LOG_FORMAT=json
